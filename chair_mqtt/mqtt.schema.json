          "$ref": "#/$defs/esp_command_result"
        }
      ]
    },
    "sample": {
      "type": "object",
      "properties": {
        "offset_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ax": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "ay": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "az": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "gx": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "gy": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "gz": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      },
      "required": [
        "offset_ms",
        "ax",
        "ay",
        "az",
        "gx",
        "gy",
        "gz"
      ],
