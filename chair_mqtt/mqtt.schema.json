          "minimum": 0,
          "maximum": 3
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "applied",
            "already_applied",
            "revision_conflict",
            "stale_revision",
            "busy",
            "command_conflict"
          ]
        }
      },
      "required": [
        "version",
        "type",
        "node_id",
        "boot_id",
        "seq",
        "uptime_ms",
        "occupied",
        "battery_mv",
        "config_revision",
        "health_flags",
        "command_id",
        "status"
      ],
      "additionalProperties": false
    },
