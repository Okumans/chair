{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartchair:mqtt:v1",
  "title": "Smart Chair MQTT v1 contract",
  "$comment": "Topic routing, exact integer syntax, cross-field relations and transport flags are checked by contract.py. All references are local.",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/movement"
    },
    {
      "$ref": "#/$defs/movement_loss"
    },
    {
      "$ref": "#/$defs/report_update"
    },
    {
      "$ref": "#/$defs/report_status"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/command_error"
    },
    {
      "$ref": "#/$defs/bridge_status"
    }
  ],
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "safe_int": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "boot": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "const": "0000000000000000"
      }
    },
    "generation": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-7][0-9a-f]{15}$",
      "not": {
        "const": "0000000000000000"
      }
    },
    "mac": {
      "type": "string",
      "minLength": 17,
      "maxLength": 17,
      "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/u32"
        },
        "heartbeat_s": {
          "$ref": "#/$defs/seq"
        },
        "movement_batch_s": {
          "$ref": "#/$defs/seq"
        },
        "movement_enabled": {
          "type": "boolean"
        },
        "radio_windows_enabled": {
          "type": "boolean"
        },
        "radio_interval_s": {
          "$ref": "#/$defs/seq"
        },
        "radio_open_s": {
          "$ref": "#/$defs/seq"
        },
        "radio_motion_tail_s": {
          "$ref": "#/$defs/seq"
        }
      },
      "required": [
        "revision",
        "heartbeat_s",
        "movement_batch_s",
        "movement_enabled",
        "radio_windows_enabled",
        "radio_interval_s",
        "radio_open_s",
        "radio_motion_tail_s"
      ],
      "additionalProperties": false
    },
    "esp_occupied": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "type": {
          "const": "OCCUPIED"
        },
        "node_id": {
          "$ref": "#/$defs/node"
        },
        "boot_id": {
          "$ref": "#/$defs/boot"
        },
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "uptime_ms": {
          "$ref": "#/$defs/u32"
        },
        "occupied": {
          "const": true
        },
        "battery_mv": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65534
            },
            {
              "type": "null"
            }
          ]
        },
        "config_revision": {
          "$ref": "#/$defs/u32"
        },
        "health_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "version",
        "type",
        "node_id",
        "boot_id",
        "seq",
        "uptime_ms",
        "occupied",
        "battery_mv",
        "config_revision",
        "health_flags"
      ],
      "additionalProperties": false
    },
    "esp_vacated": {
