            }
          ]
        },
        "config_revision": {
          "$ref": "#/$defs/u32"
        },
        "health_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "version",
        "type",
        "node_id",
        "boot_id",
        "seq",
        "uptime_ms",
        "occupied",
        "battery_mv",
        "config_revision",
        "health_flags"
      ],
      "additionalProperties": false
    },
    "esp_heartbeat": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "type": {
          "const": "HEARTBEAT"
        },
        "node_id": {
          "$ref": "#/$defs/node"
        },
        "boot_id": {
          "$ref": "#/$defs/boot"
        },
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "uptime_ms": {
          "$ref": "#/$defs/u32"
        },
        "occupied": {
          "type": "boolean"
        },
        "battery_mv": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
