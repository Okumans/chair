            }
          ]
        },
        "config_revision": {
          "$ref": "#/$defs/u32"
        },
        "health_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "version",
        "type",
        "node_id",
        "boot_id",
        "seq",
        "uptime_ms",
        "occupied",
        "battery_mv",
