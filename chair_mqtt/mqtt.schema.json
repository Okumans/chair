        "duration_ms": {
          "$ref": "#/$defs/u32"
        },
        "end_reason": {
          "enum": [
            "interval",
            "capacity",
            "stopped",
            "vacant",
            "disabled"
          ]
        },
        "samples": {
          "type": "array",
          "maxItems": 75,
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      },
      "required": [
        "version",
        "type",
        "node_id",
        "boot_id",
        "seq",
        "uptime_ms",
        "occupied",
        "battery_mv",
        "config_revision",
        "health_flags",
        "batch_start_ms",
        "duration_ms",
        "end_reason",
        "samples"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "end_reason": {
                "enum": [
                  "interval",
                  "capacity"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "samples": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
