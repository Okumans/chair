---
CompileFlags:
  Remove:
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields

---
If:
  PathMatch: (sensor|shared)/.*
CompileFlags:
  Add:
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/8.4.0
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/8.4.0/riscv32-esp-elf
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/8.4.0/backward
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/lib/gcc/riscv32-esp-elf/8.4.0/include
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/lib/gcc/riscv32-esp-elf/8.4.0/include-fixed
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include

---
If:
  PathMatch: gateway/.*
CompileFlags:
  Add:
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include/c++/8.4.0
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include/c++/8.4.0/xtensa-esp32s3-elf
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include/c++/8.4.0/backward
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include-fixed
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include
    - -I
    - /home/okumnas/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/xtensa/esp32s3/include
    - -I
    - /home/okumnas/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/xtensa/include
