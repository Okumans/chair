---
CompileFlags:
  Remove:
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields

---
If:
  PathMatch: (sensor|shared)/.*
CompileFlags:
  Add:
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/14.2.0
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/14.2.0/riscv32-esp-elf
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/14.2.0/backward
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/lib/gcc/riscv32-esp-elf/14.2.0/include
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/lib/gcc/riscv32-esp-elf/14.2.0/include-fixed
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include

---
If:
  PathMatch: gateway/.*
CompileFlags:
  Add:
    # Clang has no Xtensa backend; use its 32-bit data model for SDK headers.
    - -D__XTENSA__
    - -m32
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/xtensa-esp-elf
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/14.2.0/backward
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include-fixed
    - -isystem
    - /home/okumnas/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include
    - -I
    - /home/okumnas/.platformio/packages/framework-arduinoespressif32-libs/esp32s3/include/xtensa/esp32s3/include
    - -I
    - /home/okumnas/.platformio/packages/framework-arduinoespressif32-libs/esp32s3/include/xtensa/include
